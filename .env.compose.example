# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# NapCat / OneBot HTTP
# Default value reaches NapCat installed on the Debian host.
NAPCAT_ENDPOINT=http://127.0.0.1:3000
NAPCAT_ACCESS_TOKEN=

# DeepLX translation
DEEPLX_ENDPOINT=
DEEPLX_API_KEY=
DEEPLX_TIMEOUT_MS=10000

# Admin
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8787
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Container storage paths
SQLITE_PATH=/app/data/dc-bot.sqlite
MEDIA_CACHE_DIR=/app/media-cache
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Host bind mount paths
DC_BOT_STATE_DIR=./data
DC_BOT_MEDIA_CACHE_DIR=./media-cache

# Delivery limits
MAX_IMAGE_BYTES=10485760
DISCORD_ATTACHMENT_TIMEOUT_MS=15000
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
